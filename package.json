{
  "name": "diocese-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rimraf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed.ts",
    "homepage:seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/homepage-seed.ts",
    "wp:fetch": "node scripts/wp-fetch.mjs",
    "wp:report": "node scripts/wp-report.mjs",
    "wp:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/wp-import.ts",
    "wp:import:dry": "cross-env WP_IMPORT_DRY=1 NODE_OPTIONS=--no-deprecation payload run scripts/wp-import.ts",
    "wp:prune": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/wp-prune.ts",
    "documents:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/documents-import.ts",
    "content:tidy": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/content-tidy.ts",
    "archbishop:restructure": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/archbishop-restructure.ts",
    "archbishop:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/archbishop-import.ts",
    "translation:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/translation-apply.ts",
    "translation:apply:dry": "cross-env TRANSLATION_DRY=1 NODE_OPTIONS=--no-deprecation payload run scripts/translation-apply.ts",
    "documents:import:dry": "cross-env DOCUMENTS_DRY=1 NODE_OPTIONS=--no-deprecation payload run scripts/documents-import.ts",
    "wp:fetch-events": "node scripts/wp-fetch-events.mjs",
    "wp:probe-stubs": "node scripts/wp-probe-stubs.mjs",
    "deaneries:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/deaneries-apply.ts",
    "appointments:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/appointments-apply.ts",
    "parishes:apply": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/parishes-apply.ts",
    "parishes:geocode": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/parishes-geocode.ts",
    "timings:sample": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/timings-sample.ts",
    "posts:quarantine": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/posts-quarantine.ts",
    "worksheet:export": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/worksheet-export.ts",
    "worksheet:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/worksheet-import.ts",
    "worksheet:import:dry": "cross-env WORKSHEET_DRY=1 NODE_OPTIONS=--no-deprecation payload run scripts/worksheet-import.ts",
    "check:times": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/check-time-parsing.ts",
    "newsletter:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/newsletter-import.ts",
    "newsletter:import:dry": "cross-env NEWSLETTER_DRY=1 NODE_OPTIONS=--no-deprecation payload run scripts/newsletter-import.ts",
    "videos:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/videos-import.ts",
    "videos:import:dry": "cross-env VIDEOS_DRY=1 NODE_OPTIONS=--no-deprecation payload run scripts/videos-import.ts",
    "albums:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/albums-import.ts",
    "albums:import:dry": "cross-env ALBUMS_DRY=1 NODE_OPTIONS=--no-deprecation payload run scripts/albums-import.ts",
    "demo:prepare": "node scripts/demo-copy.mjs && cross-env DATABASE_URI=file:./demo-data/diocese.db payload run scripts/demo-prepare.ts && node scripts/demo-scrub.mjs"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "^3.89.0",
    "@payloadcms/next": "^3.89.0",
    "@payloadcms/richtext-lexical": "^3.89.0",
    "graphql": "^16.14.2",
    "leaflet": "^1.9.4",
    "next": "16.3.4",
    "payload": "^3.89.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/jsdom": "^30.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "type": "module"
}
